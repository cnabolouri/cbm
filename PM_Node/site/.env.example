# Copy to .env.local for development, and set the same values in the Vercel
# project settings for production. Never commit .env.local.

# Contact form email via Resend (https://resend.com).
# Without these three the contact page still renders and validates, but
# submissions return a "not configured yet" message instead of sending.
RESEND_API_KEY=

# Verified sender in Resend, e.g. "PM Node <hello@pm-node.sinabolouri.com>".
# The sending domain must be verified in Resend before this works.
CONTACT_EMAIL_FROM=

# Where contact submissions are delivered.
CONTACT_EMAIL_TO=
